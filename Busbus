        init() {
            window.addEventListener('keydown', (e) => this.handleKeyDown(e), { capture: true });
            Logger.info("Keyboard & Remote Control Engine Online.");
        },

        handleKeyDown(e) {
            // Ignore keystrokes inside text inputs or editable elements
            const activeTag = document.activeElement ? document.activeElement.tagName.toLowerCase() : '';
            if (activeTag === 'input' || activeTag === 'textarea' || document.activeElement.isContentEditable) {
                return;
            }

            if (!State.get('isMasterEnabled')) return;

            switch (e.code) {
                // Space or KeyK: Toggle Play / Pause
                case 'Space':
                case 'KeyK': {
                    e.preventDefault();
                    const video = SpatialEngine.getActiveVideo();
                    if (video) {
                        if (video.paused) video.play();
                        else video.pause();
                        EventBus.emit('ui:toast', video.paused ? 'Paused' : 'Playing');
                    }
                    break;
                }

                // KeyM: Toggle Mute
                case 'KeyM': {
                    e.preventDefault();
                    const newMute = !State.get('isMuted');
                    State.update('isMuted', newMute);
                    EventBus.emit('ui:toast', newMute ? 'Muted' : 'Unmuted');
                    break;
                }

                // ArrowUp / ArrowDown: Navigate Feed
                case 'ArrowUp': {
                    e.preventDefault();
                    SpatialEngine.scrollToAdjacent(-1);
                    break;
                }
                case 'ArrowDown': {
                    e.preventDefault();
                    SpatialEngine.scrollToAdjacent(1);
                    break;
                }

                // ArrowLeft / ArrowRight: Seek 5s or Trigger Carousel
                case 'ArrowLeft': {
                    e.preventDefault();
                    const video = SpatialEngine.getActiveVideo();
                    if (video) {
                        video.currentTime = Math.max(0, video.currentTime - 5);
                    } else {
                        EventBus.emit('carousel:trigger', 'left');
                    }
                    break;
                }
                case 'ArrowRight': {
                    e.preventDefault();
                    const video = SpatialEngine.getActiveVideo();
                    if (video) {
                        video.currentTime = Math.min(video.duration || 0, video.currentTime + 5);
                    } else {
                        EventBus.emit('carousel:trigger', 'right');
                    }
                    break;
                }

                // KeyF: Toggle Fullscreen / Aspect Ratio Mode
                case 'KeyF': {
                    e.preventDefault();
                    EventBus.emit('ui:toggle_aspect_ratio');
                    break;
                }

                // KeyC: Open Custom Comments
