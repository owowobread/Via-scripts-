            // Clear timers and revert states
            if (this.state.timer) { clearTimeout(this.state.timer); this.state.timer = null; }
            if (this.state.isPressing) {
                this.state.isPressing = false;
                if (this.state.activeVideo) this.state.activeVideo.playbackRate = State.get('playbackSpeed') || 1;
            }
            if (this.state.isScrubbing) this.state.isScrubbing = false;
            if (this.state.preventClick) setTimeout(() => { this.state.preventClick = false; }, 100);

            // Compute Swipe Navigation (Velocity + Distance)
            const diffY = this.state.touchStartY - e.changedTouches[0].clientY;
            const diffX = this.state.touchStartX - e.changedTouches[0].clientX;
            const duration = Date.now() - this.state.startTime;
            const velocityY = Math.abs(diffY) / duration;

            // Fluid Carousel Swipe Handling
            if (Math.abs(diffX) > Math.abs(diffY)) {
                if (Math.abs(diffX) > 40) {
                    const activeMedia = SpatialEngine.getActiveMedia();
                    if (activeMedia && activeMedia.tagName === 'IMG') {
                        EventBus.emit('carousel:trigger', diffX > 0 ? 'next' : 'prev');
                    }
                }
                return;
            }

            // Swipe Up/Down Navigation (Triggered by either distance > 100px OR fast flick)
            if (diffY > 100 || (diffY > 40 && velocityY > 0.5)) {
                EventBus.emit('nav:execute', 'next');
            } else if (diffY < -100 || (diffY < -40 && velocityY > 0.5)) {
                EventBus.emit('nav:execute', 'prev');
            }
        },

        handleWheel(e) {
            if (!State.get('isMasterEnabled') || !Router.isVideoPage()) return;
            if (e.composedPath().some(el => el.id === 'ig-bottom-ui')) return;
            
            EventBus.emit('ui:hide_controls');
            if (this.wheelTimeout) clearTimeout(this.wheelTimeout);
            this.wheelTimeout = setTimeout(() => {
                if (e.deltaY > 60) EventBus.emit('nav:execute', 'next');
                else if (e.deltaY < -60) EventBus.emit('nav:execute', 'prev');
            }, 100);
        },

        handleClick(e) {
            if (!State.get('isMasterEnabled') || !Router.isVideoPage()) return;
            if (this.state.preventClick) {
                e.stopPropagation(); e.preventDefault(); return;
            }
            const path = e.composedPath();
            // Edges reserved for carousel
            if (e.clientX < window.innerWidth * 0.15 || e.clientX > window.innerWidth * 0.85) return;

            const isUIClick = path.some(el => (el.tagName === 'BUTTON' || (el.classList && el.classList.contains('ig-pointer'))));
            if (!isUIClick) {
                if (!State.get('controlsVisible')) EventBus.emit('ui:show_controls');
                else EventBus.emit('ui:hide_controls');
            }
        }
    };

    // Attach controllers to global scope for module access
    window.__Nuke.GestureController = GestureController;
    
    // Initialize Gesture Engine
    GestureController.init();
    // =========================================================================
    // 9. NAVIGATION & PLAYLIST CONTROLLER
    // =========================================================================
    // Intercepts URL changes, maintains an active playlist of scraped posts,
    // and provides a seamless custom loading screen between swipes.

    const NavigationController = {
        isNavigating: false,
        lastHref: location.href,
        wasModalOpen: false,

        init() {
            // Monitor URL changes without relying on full page reloads (SPA routing)
            setInterval(() => this.watchSPAState(), 100);
            
            // Pre-fetch playlist builder (Runs every second to scrape visible grids)
            setInterval(() => this.buildPlaylist(), 1000);

            // Bind to EventBus
            EventBus.on('nav:execute', (dir) => this.executeNavigation(dir));
            
            Logger.info("Navigation Engine Online.");
        },

        watchSPAState() {
            const isModalOpen = document.querySelector('div[role="dialog"]') !== null;
            if (location.href !== this.lastHref || isModalOpen !== this.wasModalOpen) {
                const newPath = window.location.pathname;
                const oldPath = new URL(this.lastHref).pathname;
                const isSpecificPost = /\/(p|reel|reels|tv)\/([^\/?]+)/.test(newPath);
                
                // Clear playlist if leaving a specific grid view
                if (!isSpecificPost && newPath !== oldPath) {
                    State.update('playlist', []);
                    localStorage.removeItem('ig_nuke_playlist_time');
                }
                
                this.lastHref = location.href;
                this.wasModalOpen = isModalOpen;
                
                if (Router.isVideoPage()) {
                    State.update('controlsVisible', true);
                    EventBus.emit('ui:show_controls');
                }
                EventBus.emit('ui:sync_master_state');
                EventBus.emit('ui:sync_feed_icon');
            }
        },

        buildPlaylist() {
            if (!State.get('isMasterEnabled')) return;
            const links = Array.from(document.querySelectorAll('a[href*="/p/"], a[href*="/reel/"]'));
            if (links.length > 0) {
                const extractedCodes = links.map(a => { 
                    const match = a.href.match(/\/(?:p|reel|reels)\/([^\/?]+)/); 
                    return match ? match[1] : null; 
                }).filter(Boolean);
                
                if (extractedCodes.length > 0) {
                    let existing = State.get('playlist') || [];
                    let updated = [...new Set([...existing, ...extractedCodes])]; 
                    if (updated.length > 300) updated = updated.slice(-300); // Cap at 300 to save memory
                    State.update('playlist', updated);
                    localStorage.setItem('ig_nuke_playlist_time', Date.now().toString()); 
                }
            }
        },

        executeNavigation(direction) {
            if (this.isNavigating || !State.get('isMasterEnabled')) return;
            
            let currentShortcode = null;
            const pathMatch = window.location.pathname.match(/\/(?:p|reel|reels)\/([^\/?]+)/);
            
            if (pathMatch) {
                currentShortcode = pathMatch[1];
            } else {
                const m = SpatialEngine.getActiveMedia();
                if (m) currentShortcode = FiberEngine.extractShortcode(m);
            }
            
            if (!currentShortcode) return;
            
            const playlist = State.get('playlist');
            if (!playlist || playlist.length === 0) return;

            const idx = playlist.indexOf(currentShortcode);
            if (idx !== -1) {
                let target = null;
                if (direction === 'next' && idx < playlist.length - 1) {
                    target = playlist[idx + 1];
                } else if (direction === 'prev' && idx > 0) {
                    target = playlist[idx - 1];
                }
                
                if (target) {
                    this.isNavigating = true; 
                    this.showLoadingScreen(direction);
                    // Force the browser to navigate
                    window.location.assign(`/p/${target}/`);
                } else {
                    EventBus.emit('ui:toast', direction === 'next' ? 'End of loaded grid.' : 'Already at the first post.');
                }
            }
        },

        showLoadingScreen(direction) {
            const loader = document.createElement('div');
            loader.id = 'ig-nuke-loader';
            loader.style.cssText = 'position:fixed;top:0;left:0;width:100vw;height:100dvh;background:#000;z-index:99999999;display:flex;justify-content:center;align-items:center;color:white;font-family:-apple-system, sans-serif;font-weight:bold;font-size:16px;flex-direction:column;gap:20px;';
            loader.innerHTML = `
                <svg width="40" height="40" viewBox="0 0 50 50" style="animation: nuke-spin 1s linear infinite;">
                    <circle cx="25" cy="25" r="20" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="4"></circle>
                    <circle cx="25" cy="25" r="20" fill="none" stroke="#fff" stroke-width="4" stroke-dasharray="31.4 125.6" stroke-linecap="round"></circle>
                </svg>
                <div>Loading ${direction === 'next' ? 'Next' : 'Previous'}...</div>
                <style>@keyframes nuke-spin { 100% { transform: rotate(360deg); } }</style>
            `;
            document.body.appendChild(loader); 
        }
    };

    // =========================================================================
    // 10. AUTO-SCROLL ENGINE
    // =========================================================================
    
    const AutoScrollEngine = {
        intervalTimer: null,
        lastActiveVideo: null,
        lastVideoTime: 0,

        init() {
            EventBus.on('state:autoScroll', (isEnabled) => {
                const btn = document.getElementById('ui-btn-autoscroll');
                if (isEnabled) {
                    if (btn) btn.style.color = '#1d9bf0';
                    EventBus.emit('ui:toast', 'Auto-scroll: ON');
                    this.start();
                } else {
                    if (btn) btn.style.color = 'rgba(255,255,255,0.85)';
                    EventBus.emit('ui:toast', 'Auto-scroll: OFF');
                    this.stop();
                }
            });

            // Restore state on boot
            if (State.get('autoScroll')) this.start();
            Logger.info("AutoScroll Engine Online.");
        },

        start() {
            if (this.intervalTimer) clearInterval(this.intervalTimer);
            this.intervalTimer = setInterval(() => this.tick(), 500);
        },

        stop() {
            if (this.intervalTimer) clearInterval(this.intervalTimer);
            this.intervalTimer = null;
            this.lastActiveVideo = null;
        },

        tick() {
            if (!State.get('autoScroll') || !Router.isVideoPage()) return;
            
            const activeMedia = SpatialEngine.getActiveVideo();
            if (activeMedia) {
                if (activeMedia !== this.lastActiveVideo) { 
                    this.lastActiveVideo = activeMedia; 
                    this.lastVideoTime = activeMedia.currentTime; 
                } else {
                    const hasLooped = (this.lastVideoTime - activeMedia.currentTime) > 1; 
                    const hasEnded = activeMedia.currentTime >= activeMedia.duration - 0.2;
                    
                    if (hasLooped || hasEnded) {
                        const currentContainer = SpatialEngine.getMediaContainer(activeMedia);
                        if (currentContainer && currentContainer.nextElementSibling) { 
                            currentContainer.nextElementSibling.scrollIntoView({ behavior: 'smooth', block: 'start' }); 
                        } else { 
                            EventBus.emit('nav:execute', 'next');
                        }
                        this.lastVideoTime = 0; 
                        this.lastActiveVideo = null; 
                        return; 
                    }
                    this.lastVideoTime = activeMedia.currentTime;
                }
            }
        }
    };

    // =========================================================================
    // 11. NATIVE DOM ACTION INJECTOR
    // =========================================================================
    // Instagram actively obscures buttons (Follow, Save, Carousel Next). 
    // This engine uses complex heuristic scraping to find and trigger native events.

    const NativeInjector = {
        
        triggerCarousel(direction) {
            const activeMedia = SpatialEngine.getActiveMedia();
            if (!activeMedia) return;
            const container = SpatialEngine.getMediaContainer(activeMedia);
            if (!container) return;
            
            let targetBtn = null;
            const buttons = Array.from(container.querySelectorAll('button, [role="button"], a[role="button"]'));
            
            if (direction === 'next') {
                targetBtn = buttons.find(b => { const l = (b.getAttribute('aria-label')||'').toLowerCase(); return l.includes('next') || l.includes('right'); });
            } else {
                targetBtn = buttons.find(b => { const l = (b.getAttribute('aria-label')||'').toLowerCase(); return l.includes('go back') || l.includes('previous') || l.includes('left'); });
            }
            
            if (targetBtn) {
                this.simulateClick(targetBtn);
            } else {
                // Fallback: Manually scroll the internal UL element
                const ul = container.querySelector('ul');
                if (ul) {
                    const scrollAmount = ul.clientWidth;
                    ul.scrollBy({ left: direction === 'next' ? scrollAmount : -scrollAmount, behavior: 'smooth' });
                }
            }
        },

        triggerFollow(btnElement) {
            // Reset AutoScroll timer to prevent jumping while modal is open
            AutoScrollEngine.lastVideoTime = 0;
            
            const activeMedia = SpatialEngine.getActiveMedia();
            let container = SpatialEngine.getMediaContainer(activeMedia) || document.body;
            
            const isCurrentlyFollowing = btnElement.classList.contains('following');
            let nativeBtn = null;

            if (isCurrentlyFollowing) {
                // Unfollow Sequence
                nativeBtn = Array.from(container.querySelectorAll('button, div[role="button"], a[role="button"]'))
                    .find(b => ['following', 'requested'].includes((b.innerText || '').trim().toLowerCase()));
                
                let threeDotsSvg = null;
                if (!nativeBtn) {
                    threeDotsSvg = Array.from(container.querySelectorAll('svg')).find(s => {
                        const label = (s.getAttribute('aria-label') || '').toLowerCase();
                        return label === 'more options' || label === 'more';
                    });
                }

                if (!nativeBtn && !threeDotsSvg && container !== document.body) {
                    nativeBtn = Array.from(document.querySelectorAll('button, div[role="button"], a[role="button"]'))
                        .find(b => ['following', 'requested'].includes((b.innerText || '').trim().toLowerCase()));
                }
                
                if (nativeBtn) {
                    this.simulateClick(nativeBtn);
                    this.handleUnfollowConfirm(btnElement);
                } else if (threeDotsSvg) {
                    const menuBtn = threeDotsSvg.closest('button, [role="button"]') || threeDotsSvg;
                    this.simulateClick(menuBtn);
                    this.handleMenuUnfollowConfirm(btnElement);
                } else {
                    EventBus.emit('ui:toast', 'Unfollow button not found');
                }
            } else {
                // Follow Sequence
                nativeBtn = Array.from(container.querySelectorAll('button, div[role="button"], a[role="button"]'))
                    .find(b => ['follow', 'follow back'].includes((b.innerText || '').trim().toLowerCase()));
                if (!nativeBtn && container !== document.body) {
                    nativeBtn = Array.from(document.querySelectorAll('button, div[role="button"], a[role="button"]'))
                        .find(b => ['follow', 'follow back'].includes((b.innerText || '').trim().toLowerCase()));
                }

                if (nativeBtn) {
                    this.simulateClick(nativeBtn);
                    this.updateFollowBtnUI(btnElement, true);
                    EventBus.emit('ui:toast', 'Follow Triggered!');
                } else {
                    EventBus.emit('ui:toast', 'Follow button not found');
                }
            }
        },

        handleUnfollowConfirm(uiBtn) {
            let attempts = 0;
            const timer = setInterval(() => {
                attempts++;
                const confirmBtn = Array.from(document.querySelectorAll('button, [role="button"], [role="menuitem"], [role="dialog"] button'))
                    .find(b => (b.innerText || '').trim().toLowerCase() === 'unfollow');
                
                if (confirmBtn) {
                    clearInterval(timer);
                    this.simulateClick(confirmBtn);
                    AutoScrollEngine.lastVideoTime = 0;
                    this.updateFollowBtnUI(uiBtn, false);
                    EventBus.emit('ui:toast', 'Unfollowed!');
                }
                if (attempts > 20) clearInterval(timer);
            }, 50);
        },

        handleMenuUnfollowConfirm(uiBtn) {
            let attempts = 0;
            const timer = setInterval(() => {
                attempts++;
                const confirmBtn = Array.from(document.querySelectorAll('button, [role="button"], [role="menuitem"], [role="dialog"] button, span'))
                    .find(b => (b.innerText || '').trim().toLowerCase() === 'unfollow');
                
                if (confirmBtn) {
                    clearInterval(timer);
                    AutoScrollEngine.lastVideoTime = 0;
                    const targetBtn = confirmBtn.closest('button, [role="button"], [role="menuitem"]') || confirmBtn;
                    this.simulateClick(targetBtn);
                    
                    // Secondary confirmation check
                    setTimeout(() => {
                        AutoScrollEngine.lastVideoTime = 0;
                        const finalConfirm = Array.from(document.querySelectorAll('button, [role="button"], [role="dialog"] button'))
                            .find(b => (b.innerText || '').trim().toLowerCase() === 'unfollow');
                        if (finalConfirm) this.simulateClick(finalConfirm);
                    }, 300);

                    this.updateFollowBtnUI(uiBtn, false);
                    EventBus.emit('ui:toast', 'Unfollowed!');

                } else if (attempts > 30) {
                    clearInterval(timer);
                    const cancelBtn = Array.from(document.querySelectorAll('button, [role="button"], [role="menuitem"], [role="dialog"] button'))
                        .find(b => (b.innerText || '').trim().toLowerCase() === 'cancel');
                    if(cancelBtn) cancelBtn.click();
                }
            }, 50);
        },

        updateFollowBtnUI(btn, isFollowing) {
            if (isFollowing) {
                btn.innerHTML = 'Following'; 
                btn.classList.add('following');
            } else {
                btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg> Follow'; 
                btn.classList.remove('following');
            }
        },

        triggerSave(saveBtnElement) {
            const activeMedia = SpatialEngine.getActiveMedia();
            if (!activeMedia) return EventBus.emit('ui:toast', 'No active post found');

            const postContainer = SpatialEngine.getMediaContainer(activeMedia);
            if (postContainer) {
                const svgs = postContainer.querySelectorAll('svg'); 
                let nativeClicked = false;
                
                for (let svg of svgs) {
                    let label = (svg.getAttribute('aria-label') || '').trim();
                    if (label === 'Save' || label === 'Remove') {
                        const btn = svg.closest('button, [role="button"], a') || svg;
                        this.simulateClick(btn);
                        
                        const svgIcon = saveBtnElement.querySelector('svg');
                        if(label === 'Save') { 
                            svgIcon.style.fill = 'white'; 
                            EventBus.emit('ui:toast', "Saved!"); 
                        } else { 
                            svgIcon.style.fill = 'none'; 
                            EventBus.emit('ui:toast', "Removed!"); 
                        }
                        nativeClicked = true; 
                        break;
                    }
                    
                    // Fallback matching by polygon path
                    const poly = svg.querySelector('polygon'); 
                    const path = svg.querySelector('path');
                    if ((poly && poly.getAttribute('points') && poly.getAttribute('points').includes('20 21 12')) || 
                        (path && path.getAttribute('d') && path.getAttribute('d').includes('20 21 12'))) {
                        const btn = svg.closest('button, [role="button"], a') || svg;
                        this.simulateClick(btn);
                        EventBus.emit('ui:toast', "Bookmark Toggled!"); 
                        nativeClicked = true; 
                        break;
                    }
                }
                if (nativeClicked) return; 
            }
            
            // IF native DOM fails, execute headless Bot Tab strategy
            let shortcode = FiberEngine.extractShortcode(activeMedia);
            if (!shortcode) {
                const urlMatch = window.location.pathname.match(/\/(?:p|reel|reels)\/([^\/?]+)/); 
                if (urlMatch) shortcode = urlMatch[1]; 
            }
            
            if (shortcode) {
                localStorage.removeItem('ig_bot_result');
                const botTab = window.open(`/p/${shortcode}/?auto_save_bot=true`, 'ig_bot_tab', 'width=100,height=100,left=-1000,top=-1000');
                if (!botTab) return EventBus.emit('ui:toast', "Browser blocked popup! Allow popups.");
                
                EventBus.emit('ui:toast', "Bot opening tab...");
                let checkAttempts = 0;
                const statusChecker = setInterval(() => {
                    checkAttempts++;
                    if (checkAttempts > 150) { 
                        clearInterval(statusChecker); 
                        if (botTab && !botTab.closed) botTab.close(); 
                        return EventBus.emit('ui:toast', "Tab timeout"); 
                    }
                    const result = localStorage.getItem('ig_bot_result');
                    if (result) {
                        clearInterval(statusChecker); 
                        localStorage.removeItem('ig_bot_result'); 
                        if (botTab && !botTab.closed) botTab.close();
                        
                        const svgIcon = saveBtnElement.querySelector('svg');
                        if (result === 'saved' || result === 'toggled') { 
                            svgIcon.style.fill = 'white'; 
                            EventBus.emit('ui:toast', "Saved to Profile!"); 
                        } else if (result === 'removed') { 
                            svgIcon.style.fill = 'none'; 
                            EventBus.emit('ui:toast', "Removed from Profile!"); 
                        } else {
                            EventBus.emit('ui:toast', "Bot Error");
                        }
                    }
                }, 100);
            } else {
                EventBus.emit('ui:toast', 'Error: Cannot extract URL');
            }
        },

        simulateClick(element) {
            element.dispatchEvent(new MouseEvent('mousedown', { bubbles: true })); 
            element.dispatchEvent(new MouseEvent('mouseup', { bubbles: true })); 
            element.click();
        }
    };

    // Attach to global window
    window.__Nuke.NavigationController = NavigationController;
    window.__Nuke.AutoScrollEngine = AutoScrollEngine;
    window.__Nuke.NativeInjector = NativeInjector;

    // Boot the modules
    NavigationController.init();
    AutoScrollEngine.init();

    // Bind Carousel events triggered by the edge UI elements (created in Part 2)
    EventBus.on('carousel:trigger', (dir) => NativeInjector.triggerCarousel(dir));

    // =========================================================================
    // 12. ADVANCED COMMENTS ENGINE (GRAPHQL INTERCEPTOR & RENDERER)
    // =========================================================================
    // Bypasses the native comments page by hitting Instagram's GraphQL directly,
    // parsing the nodes, and rendering them in our custom bottom sheet.

    const CommentsEngine = {
        sheet: null,
        list: null,
        input: null,
        postBtn: null,
        
        init() {
            // Wait for UIFactory to inject the shell
            setTimeout(() => {
                this.sheet = document.getElementById('ig-comments-sheet');
                this.list = document.getElementById('ig-comments-list');
                this.input = document.getElementById('ig-comment-input');
                this.postBtn = document.getElementById('ig-comment-post-btn');
                
                if (!this.sheet) return;

                document.getElementById('ig-comments-close').addEventListener('click', () => this.close());
                
                // Input logic
                this.input.addEventListener('input', (e) => {
                    if (e.target.value.trim().length > 0) this.postBtn.classList.add('active');
                    else this.postBtn.classList.remove('active');
                });
                
                this.postBtn.addEventListener('click', () => this.handlePostComment());

                // Close on tap outside
                window.addEventListener('click', (e) => {
                    if (this.sheet.classList.contains('open')) {
                        const path = e.composedPath();
                        if (!path.some(el => el.id === 'ig-comments-sheet' || el.id === 'ui-btn-comment')) {
                            this.close();
                        }
                    }
                }, { capture: true });

                EventBus.on('comments:open', () => this.open());
                Logger.info("Comments Engine Online.");
            }, 500);
        },

        parseTimeAgo(timestamp) {
            if (!timestamp) return 'Just now';
            const seconds = Math.floor((new Date() - new Date(timestamp * 1000)) / 1000);
            if (seconds < 60) return `${seconds}s`;
            if (seconds < 3600) return `${Math.floor(seconds / 60)}m`;
            if (seconds < 86400) return `${Math.floor(seconds / 3600)}h`;
            if (seconds < 604800) return `${Math.floor(seconds / 86400)}d`;
            return `${Math.floor(seconds / 604800)}w`;
        },

        renderSkeletons() {
            if (!this.list) return;
            this.list.innerHTML = Array(6).fill('').map(() => `
                <div class="ig-comment-item" style="animation: none; opacity: 1; transform: none;">
                    <div class="ig-skeleton ig-skel-avatar"></div>
                    <div class="ig-comment-content">
                        <div class="ig-skeleton ig-skel-line short"></div>
                        <div class="ig-skeleton ig-skel-line"></div>
                        <div class="ig-skeleton ig-skel-line short" style="width: 20%;"></div>
                    </div>
                </div>
            `).join('');
        },

        async fetchAndRender(shortcode) {
            this.renderSkeletons();
            try {
                // Utilize IG's native GraphQL endpoint for parent comments
                const res = await fetch(`https://www.instagram.com/graphql/query/?query_hash=bc3296d1ce80c689ca5820ee043ef991&variables={"shortcode":"${shortcode}","first":25}`);
                if (!res.ok) throw new Error("Network response was not ok");
                const data = await res.json();
                
                const comments = data?.data?.shortcode_media?.edge_media_to_parent_comment?.edges || [];
                this.list.innerHTML = '';
                
                if (comments.length === 0) {
                    this.list.innerHTML = `<div style="text-align:center; color:rgba(255,255,255,0.5); margin-top:40px;">No comments yet.</div>`;
                    return;
                }

                comments.forEach((edge, index) => {
                    const node = edge.node;
                    const delay = index * 0.05;
                    const html = `
                        <div class="ig-comment-item" style="animation-delay: ${delay}s">
                            <img class="ig-comment-avatar" src="${node.owner.profile_pic_url}" onclick="window.location.href='/${node.owner.username}/'">
                            <div class="ig-comment-content">
                                <div class="ig-comment-header">
                                    <span class="ig-comment-user" onclick="window.location.href='/${node.owner.username}/'">${node.owner.username}</span>
                                    <span class="ig-comment-time">${this.parseTimeAgo(node.created_at)}</span>
                                </div>
                                <div class="ig-comment-text">${node.text}</div>
                                <div class="ig-comment-actions">
                                    <span class="ig-comment-action-btn">Reply</span>
                                </div>
                            </div>
                            <div class="ig-comment-like-col ${node.viewer_has_liked ? 'liked' : ''}">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                                <span>${node.edge_liked_by ? node.edge_liked_by.count : ''}</span>
                            </div>
                        </div>
                    `;
                    this.list.insertAdjacentHTML('beforeend', html);
                });
            } catch (err) {
                Logger.error("Failed to fetch comments:", err);
