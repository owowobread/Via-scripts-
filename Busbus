                if (activeMedia !== this.currentExtractedMedia) {
                    this.currentExtractedMedia = activeMedia;
                    const pData = FiberEngine.extractProfileData(activeMedia);
                    
                    if (pData) {
                        const uiUsername = document.getElementById('ui-username');
