// 26. DOM GARBAGE COLLECTOR & ANTI-LAG ENGINE (RAM SAVER)
// =========================================================================
(function(Nuke) {
    'use strict';

    if (!Nuke) return;
    const { Logger, SpatialEngine } = Nuke;

    const GarbageCollector = {
        maxDOMNodes: 15, // Maximum number of feed items to keep fully rendered
        sweepInterval: null,

        init() {
            // Run sweep every 5 seconds
            this.sweepInterval = setInterval(() => this.sweep(), 5000);
            Logger.info("DOM Garbage Collector Online. Anti-Lag engaged.");
        },

        sweep() {
            if (!Nuke.State.get('isMasterEnabled')) return;

            // Instagram feed posts are typically wrapped in <article> tags
            const articles = Array.from(document.querySelectorAll('article'));
            if (articles.length <= this.maxDOMNodes) return;

            const viewportCenter = window.scrollY + (window.innerHeight / 2);

            // Calculate distance of each article from the center of the screen
            const measured = articles.map(article => {
                const rect = article.getBoundingClientRect();
                const center = rect.top + window.scrollY + (rect.height / 2);
                return {
                    el: article,
                    distance: Math.abs(viewportCenter - center)
                };
            });

            // Sort by distance (closest first)
            measured.sort((a, b) => a.distance - b.distance);

            // The ones furthest away (beyond maxDOMNodes) get purged or recycled
            const toRecycle = measured.slice(this.maxDOMNodes);

            toRecycle.forEach(item => {
                if (item.el.dataset.nukePurged) return;

                // Strip rich media to save RAM (videos/images)
                const mediaElements = item.el.querySelectorAll('video, img');
                mediaElements.forEach(media => {
                    if (media.tagName.toLowerCase() === 'video') {
                        media.pause();
                        media.removeAttribute('src'); // Free memory
                        media.load();
                    } else if (media.tagName.toLowerCase() === 'img') {
                        // Keep a low-res placeholder or just clear it
                        media.src = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'; 
                    }
                });

                // Hide completely to speed up browser paint/reflow calculations
                item.el.style.setProperty('display', 'none', 'important');
                item.el.dataset.nukePurged = "true";
            });
        }
    };

    Nuke.GarbageCollector = GarbageCollector;
    GarbageCollector.init();

})(window.__Nuke);

