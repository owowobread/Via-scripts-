                                uiFollowBtn.classList.remove('following'); 
                            }
                        }
                    }
                    
                    // Sync native Save button state to Custom UI
                    const postContainer = SpatialEngine.getMediaContainer(activeMedia);
                    let isSaved = false;
                    if (postContainer) {
                        const svgs = postContainer.querySelectorAll('svg');
                        for (let svg of svgs) {
                            let label = (svg.getAttribute('aria-label') || '').trim();
                            if (label === 'Remove') { isSaved = true; break; }
                            if (label === 'Save') { isSaved = false; break; }
                        }
                    }
                    const saveSvg = document.querySelector('#ui-btn-save svg');
                    if (saveSvg) saveSvg.style.fill = isSaved ? 'white' : 'none';
                }
            }

            // Enforce Video State (Speed & Mute) across all media elements
            const centerVideo = SpatialEngine.getActiveVideo();
            const globalMuteState = State.get('isMuted');
            const targetSpeed = State.get('playbackSpeed');
            
            document.querySelectorAll('video').forEach(video => {
                if (video === centerVideo) {
                    if (video.duration) {
                        // Allow Gesture Controller to override speed during a hold press
                        if (video.playbackRate !== targetSpeed && (!gestureState.isPressing || gestureState.activeVideo !== video)) {
                            video.playbackRate = targetSpeed;
                        }
                        if (video.muted !== globalMuteState) { 
                            video.muted = globalMuteState; 
                            if (!globalMuteState) { 
                                video.volume = 1; 
                                video.removeAttribute('muted'); 
                            } 
                        }
                    }
                } else {
                    // Force pause and mute on all background/off-screen videos
                    if (!video.paused) video.pause();
                    video.muted = true;
                }
            });

            // Carousel Visibility Logic (Kinetic Edges)
            const leftBtn = document.getElementById('ig-carousel-left');
            const rightBtn = document.getElementById('ig-carousel-right');
            
            if (activeMedia && activeMedia.tagName === 'IMG' && State.get('isMasterEnabled') && State.get('controlsVisible')) {
                const container = SpatialEngine.getMediaContainer(activeMedia);
                let showLeft = false;
                let showRight = false;
                if (container) {
                    const buttons = Array.from(container.querySelectorAll('button, [role="button"], a[role="button"]'));
                    const hasNext = buttons.some(b => { const l = (b.getAttribute('aria-label')||'').toLowerCase(); return l.includes('next') || l.includes('right'); });
                    const hasPrev = buttons.some(b => { const l = (b.getAttribute('aria-label')||'').toLowerCase(); return l.includes('go back') || l.includes('previous') || l.includes('left'); });
                    
                    if (hasNext) showRight = true;
                    if (hasPrev) showLeft = true;
                    
                    if (!showRight && !showLeft) {
                        const ul = container.querySelector('ul');
                        if (ul && ul.children.length > 1) {
                            showLeft = true; showRight = true;
                        }
                    }
                }
                
                if (leftBtn) leftBtn.style.setProperty('display', showLeft ? 'block' : 'none', 'important');
                if (rightBtn) rightBtn.style.setProperty('display', showRight ? 'block' : 'none', 'important');
            } else {
                if (leftBtn) leftBtn.style.setProperty('display', 'none', 'important');
                if (rightBtn) rightBtn.style.setProperty('display', 'none', 'important');
            }
        }
    };

